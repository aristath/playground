{
	"name": "playground-drupal",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/playground/drupal/src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:noop",
			"dependsOn": ["build:package-json"]
		},
		"build:package-json": {
			"executor": "@wp-playground/nx-extensions:package-json",
			"options": {
				"tsConfig": "packages/playground/drupal/tsconfig.lib.json",
				"outputPath": "dist/packages/playground/drupal",
				"buildTarget": "playground-drupal:build:bundle:production"
			},
			"dependsOn": ["build:bundle"]
		},
		"build:bundle": {
			"executor": "@nx/vite:build",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"emptyOutDir": true,
			"options": {
				"outputPath": "dist/packages/playground/drupal"
			},
			"configurations": {
				"development": {
					"mode": "development"
				},
				"production": {
					"mode": "production"
				}
			},
			"dependsOn": ["^build"]
		},
		"publish": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node tools/scripts/publish.mjs playground-drupal {args.ver} {args.tag}",
				"parallel": false
			},
			"dependsOn": ["build"]
		},
		"test": {
			"executor": "nx:noop",
			"dependsOn": ["test:vite"]
		},
		"test:vite": {
			"executor": "@nx/vite:test",
			"outputs": ["{workspaceRoot}/coverage/packages/playground/drupal"],
			"options": {
				"passWithNoTests": true,
				"reportsDirectory": "../../../coverage/packages/playground/drupal"
			}
		},
		"lint": {
			"executor": "@nx/linter:eslint",
			"outputs": ["{options.outputFile}"],
			"options": {
				"useFlatConfig": false,
				"lintFilePatterns": ["packages/playground/drupal/**/*.ts"],
				"maxWarnings": 0
			}
		}
	},
	"tags": []
}
